{
  "recipes": [
    {
      "extract": {
        "ids": {
          "tmdb": {
            "group": 1,
            "regex": "/(?:movie|tv|watch|series|show)/(\\d+)",
            "source": "url",
            "transforms": ["toInt"]
          }
        },
        "title": {
          "selector": "og:title",
          "source": "meta",
          "transforms": ["trim", "collapseSpaces"]
        },
        "year": {
          "regex": "(\\d{4})",
          "selector": "datePublished",
          "source": "jsonld",
          "transforms": ["toInt"]
        }
      },
      "id": "movy-sx",
      "match": {
        "hostnames": ["www.movy.sx"],
        "urlPattern": "/movie"
      },
      "mediaType": "movie",
      "name": "Movy",
      "schemaVersion": 3,
      "tracker": "trakt",
      "video": {
        "frame": "auto",
        "selector": "video",
        "watchedThreshold": 0.8
      }
    },
    {
      "extract": {
        "ids": {
          "tmdb": {
            "group": 1,
            "regex": "/(?:movie|tv|watch|series|show)/(\\d+)",
            "source": "url",
            "transforms": ["toInt"]
          }
        },
        "title": {
          "selector": "h1",
          "source": "dom",
          "transforms": ["trim", "collapseSpaces"]
        }
      },
      "id": "popcornmovies-ac",
      "match": {
        "hostnames": ["popcornmovies.ac"],
        "urlPattern": "/watch/movie"
      },
      "mediaType": "movie",
      "name": "Popcornmovies",
      "schemaVersion": 3,
      "tracker": "trakt",
      "video": {
        "frame": "auto",
        "selector": "video",
        "watchedThreshold": 0.8
      }
    }
  ],
  "links": []
}
